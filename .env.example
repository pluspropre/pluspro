# Copy to .env.local (never commit real values — this repository is public)

# Public site URL (Production only; previews fall back to VERCEL_URL)
NEXT_PUBLIC_SITE_URL=

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# server only — used exclusively to insert quote requests
SUPABASE_SECRET_KEY=

# Resend (quote notification + confirmation e-mails)
RESEND_API_KEY=
EMAIL_FROM="+Propre <devis@plus-propre.fr>"
QUOTE_NOTIFICATION_TO=contact@plus-propre.fr

# Cloudflare Turnstile (local test keys: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# IndexNow (optional, production only): any 8–128 hex characters
INDEXNOW_KEY=
